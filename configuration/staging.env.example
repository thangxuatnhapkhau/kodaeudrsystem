# Netlify staging only. Supply fresh staging credentials through the deployment secret store.
APPS_SCRIPT_WEBAPP_URL=
BRIDGE_SECRET=
ALLOWED_ORIGINS=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=

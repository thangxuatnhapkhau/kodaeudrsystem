# Netlify secrets/configuration. Keep values out of frontend and Git.
APPS_SCRIPT_WEBAPP_URL=
BRIDGE_SECRET=
ALLOWED_ORIGINS=https://koda-eudr-system.netlify.app
# SHA-256 hashes of unique random >=32 character personal tokens, NOT plaintext.
# TOKEN_HASHES_JSON=[{"sha256":"64_hex_digits","email":"user@example.com","active":true,"expires_at":"2026-12-31T23:59:59Z"}]
TOKEN_HASHES_JSON=[]
# Optional temporary compatibility, disabled by default. Remove after rollout.
ALLOW_PILOT_ADMIN=false
PILOT_ADMIN_EMAIL=
PILOT_ADMIN_TOKEN=

,b={id,actor:u.email,case_id:scope.c.id,material_id:materialId,source_id:scope.s.id,document_ids:JSON.stringify(scope.docs.map(d=>d.id)),snapshot_hash:snapshot,status:ai?'QUEUED':'WAITING_DRIVE',result_folder_id:results.getId(),created_at:now_()},prompt=materialReviewPrompt_(b,scope,packets);if(prompt.length>settings.maxChars+90000)fail_('AI_INPUT_TOO_LARGE','Combined context exceeds prompt limit');const promptFile=storeFile_(folder_(base,'Prompts'),id,{bytes:Utilities.newBlob(prompt).getBytes(),type:'text/plain'},id+'_PROMPT.txt');if(ai){const text=JSON.stringify(packets);if(Utilities.newBlob(text).getBytes().length>3000000)fail_('AI_INPUT_TOO_LARGE','Combined OCR packet exceeds 3 MB; no source omitted');const f=storeFile_(folder_(base,'Inputs'),id,{bytes:Utilities.newBlob(text).getBytes(),type:'application/json'},id+'_OCR.json');b.input_file_id=f.getId();b.input_sha256=bridgeHex_(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,text));b.job_id=stable_('material-ai:'+id);add_('28_AI_JOBS',{id:b.job_id,actor:u.email,case_id:b.case_id,source_document_id:scope.docs[0].id,source_sha256:scope.docs[0].sha256,type:'MATERIAL_REVIEW',batch_id:id,input_file_id:b.input_file_id,input_sha256:b.input_sha256,context_hash:snapshot,status:'QUEUED',created_at:now_(),model:settings.model});}add_('32_MATERIAL_REVIEWS',b);auditOnce_('MATERIAL_REVIEW_CREATED',b.case_id,id,'',JSON.stringify({source_id:b.source_id,document_ids:JSON.parse(b.document_ids),mode:ai?'AI':'MANUAL'}),u);return {id,status:b.status,job_id:b.job_id,prompt_file_url:'https://drive.google.com/file/d/'+promptFile.getId()+'/view',result_folder_url:'https://drive.google.com/drive/folders/'+results.getId(),prompt:ai?undefined:prompt};});}

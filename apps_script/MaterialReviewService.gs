 if(Object.hasOwn(result,'sections')){if(!Array.isArray(result.sections)||result.sections.length<result.documents.length||result.sections.length>200)fail_('INVALID_INPUT','Proposed sections required for every PDF');for(const d of result.documents){let nextPage=1;const ids=new Set();for(const section of result.sections.filter(s=>s.document_id===d.document_id)){if(!section||Object.keys(section).sort().join('|')!==['document_id','section_id','title','document_type','evidence_block','start_page','end_page','confidence'].sort().join('|')||!text_(section.section_id,100)||ids.has(section.section_id)||!Number.isInteger(section.start_page)||!Number.isInteger(section.end_page)||section.start_page!==nextPage||section.end_page<section.start_page||section.end_page>d.page_count||!['','01_Commercial_Shipping','02_FSC_Certification','03_Transport','04_Geolocation'].includes(section.evidence_block)||!['HIGH','MEDIUM','LOW'].includes(section.confidence))fail_('INVALID_INPUT','Proposed sections must cover every original page once');text_(section.title,200);text_(section.document_type,100);if((section.document_type==='UNKNOWN'||!section.evidence_block)&&(section.document_type!=='UNKNOWN'||section.evidence_block!==''||section.confidence!=='LOW'))fail_('INVALID_INPUT','Uncertain sections require UNKNOWN, empty evidence_block and LOW confidence');ids.add(section.section_id);nextPage=section.end_page+1;}if(nextPage!==d.page_count+1)fail_('INVALID_INPUT','Proposed sections do not cover the full PDF');}if(result.sections.some(section=>!result.documents.some(d=>d.document_id===section.document_id)))fail_('INVALID_INPUT','Section references an unselected PDF');}

onfirmed:true,meaning:'Human mapping; no automatic approval'}),updated_at:now_(),request_key:BRIDGE_REQUEST_KEY});all.filter(x=>x.id!==id&&x.active_version==='YES').forEach(x=>patch_('06_DOCUMENT_REGISTER',x.id,{active_version:'NO',superseded_by:id,updated_at:now_()}));patch_('04_EVIDENCE_TRACKER',t.id,{document_id:id,status:'UPLOADED',updated_at:now_()});auditOnce_('MATERIAL_SOURCE_PDF_MAPPED',t.case_id,id,d.id,JSON.stringify({source_id:scope.s.id,task_id:t.id,status:'UPLOADED',file_retained:true}),u);return {id,status:'UPLOADED'};});}

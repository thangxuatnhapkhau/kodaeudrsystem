 const context=materialReviewContext_(scope),geo=result.assessments.find(a=>a.topic==='GEO_COUNTRY'),harvest=result.assessments.find(a=>a.topic==='HARVEST_PERIOD_AREA');if(geo.status==='SUPPORTED'&&(!context.geo.length||context.geo.some(g=>g.verification_status!=='VERIFIED')))geo.status='NOT_VERIFIABLE';if(harvest.status==='SUPPORTED'&&(!scope.s.harvest_start||!scope.s.harvest_end||!context.geo.length||context.geo.some(g=>!Number(g.area_ha))))harvest.status='NOT_VERIFIABLE';const graph=sourceGraphState_(scope.s),chain=result.assessments.find(a=>a.topic==='CHAIN'),qty=result.assessments.find(a=>a.topic==='LOT_QUANTITY');if(graph.issues.length&&chain.status==='SUPPORTED')chain.status='NOT_VERIFIABLE';if(graph.issues.some(x=>/QUANTITY|ALLOCATION|CONVERSION|OUTPUT_EXCEEDS/.test(x))&&qty.status==='SUPPORTED')qty.status='NOT_VERIFIABLE';if(result.documents.some(d=>d.unreadable_pages.length||d.coverage==='UNREADABLE'))result.assessments.find(a=>a.topic==='DOCUMENTS').status='NOT_VERIFIABLE';return {...result,system:{issues:graph.issues,status:result.assessments.some(a=>a.status==='MISMATCH')?'MISMATCH':result.assessments.some(a=>a.status==='MISSING')?'NEEDS_DOCUMENTS':result.assessments.some(a=>a.status==='NOT_VERIFIABLE')?'VERIFICATION_REQUIRED':'READY_FOR_REVIEW',meaning:'Human review required; this result does not approve evidence or declare EUDR compliance',citation_validation:packets?'MATCHED_OCR_TEXT':'HUMAN_SOURCE_VERIFICATION_REQUIRED'}};}

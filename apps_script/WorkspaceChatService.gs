}
function workspaceChatFolder_(c,create){const parent=DriveApp.getFolderById(c.folder),it=parent.getFoldersByName('AI_Chat_Index');return it.hasNext()?it.next():create?folder_(parent,'AI_Chat_Index'):null;}

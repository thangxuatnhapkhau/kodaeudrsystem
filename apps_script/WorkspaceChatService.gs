function getWorkspaceChatAnswer(jobId){const u=requireCapability_('AI_USE'),j=rows_('28_AI_JOBS').find(x=>x.id===jobId&&x.type==='WORKSPACE_CHAT'&&x.actor===u.email);if(!j)fail_('PERMISSION_DENIED','Chat answer unavailable');order_(j.case_id,u);let question='',result=null;if(j.input_file_id){const inputFile=DriveApp.getFileById(j.input_file_id);if(inputFile.getSize()>12000)fail_('RESULT_INTEGRITY_ERROR','Question too large');const raw=inputFile.getBlob().getDataAsString();if(bridgeHex_(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,raw))!==j.input_sha256)fail_('RESULT_INTEGRITY_ERROR','Question changed');question=String(JSON.parse(raw).question||'').slice(0,1000);}if(j.status==='DONE'&&j.result_file_id){const f=DriveApp.getFileById(j.result_file_id);if(f.getSize()>48000)fail_('RESULT_INTEGRITY_ERROR','Answer too large');result=JSON.parse(f.getBlob().getDataAsString());for(const ref of result.citations||[])document_(ref.document_id,u);}return {id:j.id,question,status:j.status,error_code:j.error_code,created_at:j.created_at,result};}
function listWorkspaceChatJobs(caseId){const u=requireCapability_('AI_USE');order_(caseId,u);return rows_('28_AI_JOBS').filter(j=>j.case_id===caseId&&j.type==='WORKSPACE_CHAT'&&j.actor===u.email).slice(-20).reverse().map(j=>({id:j.id,status:j.status,created_at:j.created_at,error_code:j.error_code}));}

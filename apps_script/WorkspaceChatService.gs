function workspaceChatPdfDocs_(caseId,u){return rows_('06_DOCUMENT_REGISTER').filter(d=>d.case_id===caseId&&d.active_version==='YES'&&d.mime_type==='application/pdf'&&d.file_id&&/^[a-f0-9]{64}$/i.test(d.sha256||'')).filter(d=>{try{document_(d.id,u);return true;}catch(e){return false;}});}

  const result={answer:rawResult.answer,citations,record_refs},text=JSON.stringify(result),output=storeFile_(workspaceChatFolder_(scope.c,true),job.id,{bytes:Utilities.newBlob(text).getBytes(),type:'application/json'},job.id+'_ANSWER.json');
  patch_('28_AI_JOBS',job.id,{result_file_id:output.getId(),status:'DONE',usage_json:JSON.stringify(reply.usage),finished_at:now_(),error_code:''});
  return {id:job.id,status:'DONE'};

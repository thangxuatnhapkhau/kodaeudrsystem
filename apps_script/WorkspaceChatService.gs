    geo:rows_('17_GEO_LOCATIONS').filter(g=>g.case_id===scope.c.id&&(!scope.materialId||g.material_id===scope.materialId)&&(!scope.sourceId||g.source_id===scope.sourceId)),
    tasks:rows_('04_EVIDENCE_TRACKER').filter(t=>t.case_id===scope.c.id&&(!scope.materialId||t.material_id===scope.materialId)&&(!scope.sourceId||t.source_id===scope.sourceId)).map(t=>({id:t.id,evidence:t.evidence,status:t.status,material_id:t.material_id,source_id:t.source_id,document_id:t.document_id}))

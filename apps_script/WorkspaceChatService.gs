  if(sourceId){if(!materialId)fail_('INVALID_INPUT','Select the material for a source');traceSource_(sourceId,materialId,u);}
  const docs=rows_('06_DOCUMENT_REGISTER').filter(d=>d.case_id===caseId&&d.active_version==='YES'&&d.mime_type==='application/pdf'&&d.file_id&&d.kind!=='DOSSIER_PART'&&(!materialId||d.material_id===materialId)&&(!sourceId||recordMatchesSource_(d,'DOCUMENT',sourceId))).filter(d=>{try{document_(d.id,u);return true;}catch(e){return false;}});

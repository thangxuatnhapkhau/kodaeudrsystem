function workspaceChatSnapshot_(scope){return stable_(JSON.stringify({case_id:scope.c.id,material_id:scope.materialId,source_id:scope.sourceId,docs:scope.docs.map(d=>[d.id,d.sha256,d.active_version]),materials:rows_('02_SO_ITEM_MATERIAL').filter(m=>m.case_id===scope.c.id).map(m=>[m.id,m.material,m.category,m.active]),sources:rows_('29_MATERIAL_SOURCES').filter(s=>s.case_id===scope.c.id).map(s=>[s.id,s.material_id,s.supplier_id,s.supplier_po,s.lot_no,s.active]),edges:rows_('31_SOURCE_EDGES').filter(e=>e.case_id===scope.c.id).map(e=>[e.id,e.source_id,e.from_node_id,e.to_node_id,e.active]),geo:rows_('17_GEO_LOCATIONS').filter(g=>g.case_id===scope.c.id).map(g=>[g.id,g.material_id,g.source_id,g.verification_status]),tasks:rows_('04_EVIDENCE_TRACKER').filter(t=>t.case_id===scope.c.id).map(t=>[t.id,t.material_id,t.source_id,t.status,t.document_id])}));}
function askWorkspaceChat(caseId,input){const u=requireCapability_('AI_USE'),scope=workspaceChatScope_(caseId,input.material_id||'',input.source_id||'',u),question=text_(input.question||'',1000).trim();if(question.length<5)fail_('INVALID_INPUT','Enter a question');if(!aiSettings_().enabled||!ScriptApp.getProjectTriggers().some(t=>t.getHandlerFunction()==='processAIJobs'))fail_('AI_CONFIG_REQUIRED','Configure Gemini and install the AI worker');const folder=workspaceChatFolder_(scope.c,false);if(scope.docs.some(d=>!workspaceChatFile_(folder,d)))fail_('INDEX_REQUIRED','Index all visible PDFs in this scope before asking; incomplete documents must not be silently ignored');return withOperation_(()=>{const id=stable_('workspace-chat:'+u.email+':'+BRIDGE_REQUEST_KEY),old=rows_('28_AI_JOBS').find(j=>j.id===id);if(old)return {id,status:old.status};const day=now_().slice(0,10),s=aiSettings_(),jobs=rows_('28_AI_JOBS').filter(j=>String(j.created_at).startsWith(day));if(jobs.length>=s.daily||jobs.filter(j=>j.actor===u.email).length>=s.perUser)fail_('AI_DAILY_LIMIT','Daily AI limit reached');const inputText=JSON.stringify({question,material_id:scope.materialId,source_id:scope.sourceId}),inputFile=storeFile_(workspaceChatFolder_(scope.c,true),id,{bytes:Utilities.newBlob(inputText).getBytes(),type:'application/json'},id+'_QUESTION.json');add_('28_AI_JOBS',{id,actor:u.email,case_id:caseId,source_document_id:scope.docs[0]?.id||'',source_sha256:scope.docs[0]?.sha256||'',type:'WORKSPACE_CHAT',input_file_id:inputFile.getId(),input_sha256:bridgeHex_(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,inputText)),context_hash:workspaceChatSnapshot_(scope),status:'QUEUED',created_at:now_(),model:s.model});return {id,status:'QUEUED'};});}
function workspaceChatTokens_(text){return [...new Set(String(text).normalize('NFKC').toLowerCase().match(/[\p{L}\p{N}]{3,}/gu)||[])].filter(x=>!['what','which','this','that','trong','những','material','chứng','từng'].includes(x));}
function workspaceChatCandidates_(scope,question){const folder=workspaceChatFolder_(scope.c,false),terms=workspaceChatTokens_(question),candidates=[],fallback=[];for(const d of scope.docs){const file=workspaceChatFile_(folder,d);if(!file||file.getSize()>3000000)fail_('INDEX_REQUIRED','PDF index is missing or too large');const saved=JSON.parse(file.getBlob().getDataAsString());if(saved.document_id!==d.id||saved.sha256!==d.sha256)fail_('VERSION_CONFLICT','PDF index changed');for(const p of saved.pages){if(!Number.isInteger(p.page)||p.page<1||!p.text)continue;const normalized=p.text.normalize('NFKC').toLowerCase(),score=terms.reduce((n,t)=>n+(normalized.includes(t)?1:0),0);const candidate={document_id:d.id,name:d.name,page:p.page,text:p.text.slice(0,3500),score};fallback.push(candidate);if(score)candidates.push(candidate);}}return (candidates.length?candidates.sort((a,b)=>b.score-a.score):fallback.sort((a,b)=>a.page-b.page)).slice(0,16);}
function workspaceChatExcerpt_(page,question){
  const body=page.text,terms=workspaceChatTokens_(question),lower=body.normalize('NFKC').toLowerCase();
  const positions=terms.map(t=>lower.indexOf(t)).filter(i=>i>=0),at=positions.length?Math.min(...positions):0;
  const start=Math.max(0,at-60),end=Math.min(body.length,start+240);
  return body.slice(start,end).trim();
}
function processWorkspaceChatJob_(job){return withAIActor_(job,()=>{

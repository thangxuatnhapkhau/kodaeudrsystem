function workspaceChatSnapshot_(scope){return stable_(JSON.stringify({case_id:scope.c.id,material_id:scope.materialId,source_id:scope.sourceId,docs:scope.docs.map(d=>[d.id,d.sha256,d.active_version]),materials:rows_('02_SO_ITEM_MATERIAL').filter(m=>m.case_id===scope.c.id).map(m=>[m.id,m.material,m.category,m.active]),sources:rows_('29_MATERIAL_SOURCES').filter(s=>s.case_id===scope.c.id).map(s=>[s.id,s.material_id,s.supplier_id,s.supplier_po,s.lot_no,s.active]),edges:rows_('31_SOURCE_EDGES').filter(e=>e.case_id===scope.c.id).map(e=>[e.id,e.source_id,e.from_node_id,e.to_node_id,e.active]),geo:rows_('17_GEO_LOCATIONS').filter(g=>g.case_id===scope.c.id).map(g=>[g.id,g.material_id,g.source_id,g.verification_status]),tasks:rows_('04_EVIDENCE_TRACKER').filter(t=>t.case_id===scope.c.id).map(t=>[t.id,t.material_id,t.source_id,t.status,t.document_id])}));}

function getWorkspaceChatIndex(caseId,materialId,sourceId){const u=requireCapability_('AI_USE'),scope=workspaceChatScope_(caseId,materialId,sourceId,u),folder=workspaceChatFolder_(scope.c,false);return {documents:scope.docs.map(d=>({id:d.id,name:d.name,material_id:d.material_id,source_id:d.source_id,sha256:d.sha256,indexed:!!workspaceChatFile_(folder,d)})),order_pdf_count:scope.orderPdfCount,model_enabled:aiSettings_().enabled,worker_installed:ScriptApp.getProjectTriggers().some(t=>t.getHandlerFunction()==='processAIJobs')};}

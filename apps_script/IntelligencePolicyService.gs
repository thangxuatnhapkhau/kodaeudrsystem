function saveKodaRegulationRule(input){const u=v290Internal_('POLICY_EDIT');if(u.role!=='ADMIN')fail_('PERMISSION_DENIED','Admin must register reviewed regulation rules');v290Ready_();if(input.confirmed!==true||!['LEGAL_REQUIREMENT','CUSTOMER_REQUIREMENT','KODA_INTERNAL_POLICY'].includes(input.category))fail_('HUMAN_CONFIRMATION_REQUIRED','Confirm rule category and review');const keys=['rule_version','source_url','scope','required_data','validation_method'],value={};for(const k of keys){value[k]=text_(input[k]||'',2000);if(!value[k])fail_('INVALID_INPUT','Rule field required: '+k);}if(!/^https:\/\//.test(value.source_url))fail_('INVALID_INPUT','Rule source URL required');value.effective_date=isoDate_(input.effective_date);const rule=input.rule_json||{};if(typeof rule!=='object'||Array.isArray(rule)||JSON.stringify(rule).length>12000)fail_('INVALID_INPUT','Invalid rule data');const id=text_(input.id||'',100);if(!id)fail_('INVALID_INPUT','Rule ID required');return withOperation_(()=>{const old=rows_('43_REGULATION_RULES').find(r=>r.id===id);if(old)fail_('VERSION_CONFLICT','Rules are versioned immutable records; create a new ID');add_('43_REGULATION_RULES',{id,...value,category:input.category,status:'APPROVED',rule_json:JSON.stringify(rule),reviewed_by:u.email,reviewed_at:now_()});auditOnce_('REGULATION_RULE_RECORDED','',id,'',JSON.stringify({category:input.category,version:value.rule_version}),u);return {id,status:'APPROVED'};});}
function saveKodaCustomerFieldMapping(input){const u=v290Internal_('POLICY_EDIT');v290Ready_();if(input.confirmed!==true)fail_('HUMAN_CONFIRMATION_REQUIRED','Confirm the field against Customer documentation');const value={customer:'La Redoute',required_flag:input.required===true?'YES':'NO',verification_state:input.verified===true?'VERIFIED':'DRAFT',last_verified_at:input.verified===true?now_():'',reviewed_by:input.verified===true?u.email:''};for(const k of ['source_field','target_field','source_record_id','transformation_rule','validation_rule','reference_version']){value[k]=text_(input[k]||'',1000);if(k!=='source_record_id'&&!value[k])fail_('INVALID_INPUT','Mapping field required: '+k);}return withOperation_(()=>{const id=stable_('customer-field:'+value.source_field+':'+value.target_field+':'+value.reference_version);if(rows_('40_CUSTOMER_FIELD_MAPPING').some(m=>m.id===id))fail_('VERSION_CONFLICT','Mapping version already registered');add_('40_CUSTOMER_FIELD_MAPPING',{id,...value});auditOnce_('CUSTOMER_FIELD_MAPPING_RECORDED','',id,'',JSON.stringify(value),u);return {id,verification_state:value.verification_state};});}

  const pack={version:'2.9.0',review_id:id,case_id:caseId,material_id:scope.material_id,source_id:scope.source_id,snapshot_hash:snapshot,context,documents:docs,issues,previous_result:previous,prepared_by:u.email,prepared_at:now_(),review_schema:v290ReviewSchema_()};

  const id=stable_('business-review:'+u.email+':'+BRIDGE_REQUEST_KEY),old=rows_('36_AI_REVIEW_IMPORTS').find(r=>r.id===id);if(old)return {id,snapshot_hash:old.snapshot_hash,pack_url:'https://drive.google.com/file/d/'+old.snapshot_file_id+'/view',instruction:'Review only this supplied authorized snapshot. Return JSON matching review_schema. Never approve evidence or declare compliance.'};

 return {$schema:'https://json-schema.org/draft/2020-12/schema',title:'KODA ChatGPT Business Review v2.9.0',...object({review_id:{...id,minLength:1},case_id:id,material_id:id,source_id:id,snapshot_hash:hash,model_review_context:text,document_references:{type:'array',minItems:0,maxItems:20,uniqueItems:true,items:object({document_id:id,sha256:hash,version:{type:'integer',minimum:1},page_count:{type:['integer','null'],minimum:1,maximum:300},coverage:{type:'string',enum:['PARTIAL','UNREADABLE','NEEDS_VISUAL_REVIEW']}})},summary:text,assessments:{type:'array',items:assessment,minItems:8,maxItems:8},findings:{type:'array',items:finding,maxItems:200},citations,recommended_actions:{type:'array',items:text,maxItems:100},review_status:{type:'string',enum:['HUMAN_VERIFICATION_REQUIRED']},reviewed_at:{type:'string',format:'date-time',maxLength:40},imported_by:id})};

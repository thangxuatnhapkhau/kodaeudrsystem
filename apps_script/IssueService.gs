function v290Issue_(id,u){const issue=rows_('37_REVIEW_ISSUES').find(i=>i.id===id);if(!issue)fail_('INVALID_INPUT','Issue not found');v290Scope_(issue.case_id,issue,u);return issue;}
function createKodaReviewIssue(reviewId,input){
 const u=v290Internal_('AI_REVIEW');v290Ready_();if(input?.confirmed!==true)fail_('HUMAN_CONFIRMATION_REQUIRED','Confirm the finding before creating an Issue');
 const {row,scope}=v290ReviewRow_(reviewId,u);traceWritable_(scope.c);const review=v290ReadReview_(row,u);if(review.status!=='IMPORTED'||!review.result)fail_('STALE_REVIEW','Use a current imported review');
 const finding=review.result.findings.find(f=>f.finding_id===input.finding_id);if(!finding)fail_('INVALID_INPUT','Finding not found');
 return withOperation_(()=>{const id=stable_('review-issue:'+reviewId+':'+finding.finding_id),old=rows_('37_REVIEW_ISSUES').find(i=>i.id===id);if(old)return {id,status:old.status};
 const now=now_(),history=[{at:now,actor:u.email,from:'',to:'PROPOSED',reason:'Finding confirmed by authorized reviewer',evidence: finding.document_ids}];
 add_('37_REVIEW_ISSUES',{id,finding_id:finding.finding_id,review_id:reviewId,case_id:row.case_id,material_id:finding.material_id||row.material_id,source_id:finding.source_id||row.source_id,priority:finding.severity,department:finding.suggested_department,required_action:finding.recommended_action,document_requirements:JSON.stringify(finding.document_ids),status:'PROPOSED',created_by:u.email,created_at:now,updated_at:now,audit_history:JSON.stringify(history)});
 auditOnce_('REVIEW_ISSUE_CREATED',row.case_id,id,'',JSON.stringify({review_id:reviewId,finding_id:finding.finding_id,status:'PROPOSED'}),u);return {id,status:'PROPOSED'};});
}
function updateKodaReviewIssue(id,input){
 const u=v290Internal_();v290Ready_();const issue=v290Issue_(id,u);traceWritable_(order_(issue.case_id,u));const reviewer=hasCapability_(u,'AI_REVIEW'),owner=issue.owner===u.email;
 if(!reviewer&&!owner)fail_('PERMISSION_DENIED','Assigned owner or reviewer required');
 if(input.confirmed!==true)fail_('HUMAN_CONFIRMATION_REQUIRED','Confirm Issue transition');const reason=text_(input.reason||'',2000);if(!reason)fail_('INVALID_INPUT','Decision reason required');
 const target=text_(input.status||'',40),transitions={PROPOSED:['REVIEWED','REJECTED'],REVIEWED:['ASSIGNED','REJECTED'],ASSIGNED:['IN_PROGRESS','REOPENED'],IN_PROGRESS:['EVIDENCE_SUBMITTED','REOPENED'],EVIDENCE_SUBMITTED:['RECHECK_REQUIRED','REOPENED'],RECHECK_REQUIRED:['RESOLVED','REOPENED','REJECTED'],RESOLVED:['REOPENED'],REJECTED:['REOPENED'],REOPENED:['REVIEWED','ASSIGNED','IN_PROGRESS']};
 if(!transitions[issue.status]?.includes(target))fail_('INVALID_INPUT','Invalid Issue transition');
 if(['REVIEWED','ASSIGNED','RESOLVED','REJECTED','REOPENED'].includes(target)&&!reviewer)fail_('PERMISSION_DENIED','Reviewer authority required');
 if(String(input.expected_updated_at||'')!==String(issue.updated_at||''))fail_('VERSION_CONFLICT','Issue changed; refresh');
 const nextOwner=input.owner===undefined?issue.owner:text_(input.owner,200),due=input.due_date===undefined?issue.due_date:input.due_date?isoDate_(input.due_date):'';
 if((nextOwner!==issue.owner||due!==issue.due_date)&&!reviewer)fail_('PERMISSION_DENIED','Reviewer assigns owners and dates');
 if(['ASSIGNED','IN_PROGRESS'].includes(target)&&(!nextOwner||!rows_('05_OWNER_MASTER').some(o=>o.email===nextOwner&&o.active==='YES'&&o.role!=='VIEWER'&&canOrder_(o,order_(issue.case_id,u)))))fail_('INVALID_INPUT','Select an active owner with Order access');
 const ids=input.resolution_evidence===undefined?jsonList_(issue.resolution_evidence):input.resolution_evidence;if(!Array.isArray(ids)||ids.length>20||new Set(ids).size!==ids.length)fail_('INVALID_INPUT','Select at most 20 evidence documents');
 const refs=ids.map(documentId=>{const d=document_(documentId,u);if(d.case_id!==issue.case_id||d.active_version!=='YES'||issue.material_id&&d.material_id!==issue.material_id||issue.source_id&&!recordMatchesSource_(d,'DOCUMENT',issue.source_id))fail_('INVALID_INPUT','Resolution evidence outside Issue scope');return d;});
 if(['EVIDENCE_SUBMITTED','RESOLVED'].includes(target)&&!refs.length)fail_('INVALID_INPUT','Resolution evidence is required');
 if(target==='RESOLVED'&&refs.some(d=>d.status!=='APPROVED'))fail_('INVALID_INPUT','Only reviewed active evidence can resolve an Issue');
 return withOperation_(()=>{TABLE_CACHE_={};const current=v290Issue_(id,u);if(current.updated_at!==issue.updated_at||current.status!==issue.status)fail_('VERSION_CONFLICT','Issue changed during update');const at=now_(),history=jsonList_(issue.audit_history);history.push({at,actor:u.email,from:issue.status,to:target,reason,evidence:ids});
 const taskId=issue.task_id||stable_('issue-task:'+id),task=rows_('04_EVIDENCE_TRACKER').find(t=>t.id===taskId),taskValue={case_id:issue.case_id,material_id:issue.material_id,source_id:issue.source_id,evidence:'Review Issue: '+issue.finding_id,department:input.department||issue.department,owner:nextOwner,due,status:target==='RESOLVED'?'APPROVED':target==='EVIDENCE_SUBMITTED'?'SUBMITTED':'MISSING',note:issue.required_action,updated_at:at,evidence_block:'01_Commercial_Shipping',required:'NO',override_state:'OPTIONAL',rule_version:'V290_ISSUE',active:'YES',assigned_reviewer:reviewer?u.email:issue.reviewed_by};
 if(target==='REJECTED')taskValue.active='NO';if(task)patch_('04_EVIDENCE_TRACKER',taskId,taskValue);else if(nextOwner)add_('04_EVIDENCE_TRACKER',{id:taskId,...taskValue,created_at:at});
 const value={status:target,owner:nextOwner,due_date:due,department:text_(input.department||issue.department||'',100),resolution_evidence:JSON.stringify(ids),reviewed_by:reviewer?u.email:issue.reviewed_by,closed_at:['RESOLVED','REJECTED'].includes(target)?at:'',updated_at:at,audit_history:JSON.stringify(history),task_id:nextOwner?taskId:issue.task_id};patch_('37_REVIEW_ISSUES',id,value);
 const savedTask=rows_('04_EVIDENCE_TRACKER').find(t=>t.id===taskId),calendar=savedTask?syncTaskCalendar_(savedTask):{status:'NOT_SCHEDULED'};
 if(savedTask){const freshTask=rows_('04_EVIDENCE_TRACKER').find(t=>t.id===taskId);patch_('37_REVIEW_ISSUES',id,{calendar_event_id:freshTask.calendar_event_id||'',calendar_sync_status:calendar.status});}
 auditOnce_('REVIEW_ISSUE_UPDATED',issue.case_id,id,JSON.stringify({status:issue.status}),JSON.stringify({status:target,reason,resolution_evidence:ids}),u);return {id,status:target,calendar};});
}
// Re-evaluate only the supplied scope. New uploads never resolve Issues automatically.
function refreshKodaReviewScope(caseId,input){const u=v290Internal_('AI_USE');v290Ready_();const scope=v290Scope_(caseId,input,u);return withOperation_(()=>{const stale=[];for(const row of rows_('36_AI_REVIEW_IMPORTS').filter(r=>r.case_id===caseId&&(!scope.material_id||r.material_id===scope.material_id)&&(!scope.source_id||r.source_id===scope.source_id)&&r.status!=='STALE')){const own=v290Scope_(caseId,row,u);if(v290Snapshot_(own)!==row.snapshot_hash){patch_('36_AI_REVIEW_IMPORTS',row.id,{status:'STALE'});stale.push(row.id);}}for(const h of rows_('42_AI_CHAT_HISTORY').filter(h=>h.case_id===caseId&&h.actor===u.email&&h.material_id===scope.material_id&&h.source_id===scope.source_id&&h.status!=='STALE'))if(h.snapshot_hash!==v290Snapshot_(scope))patch_('42_AI_CHAT_HISTORY',h.id,{status:'STALE'});return {stale_review_ids:stale,deterministic_checks:v290QueryResult_(scope,'What is preventing this source from being ready?'),issues_auto_closed:0};});}

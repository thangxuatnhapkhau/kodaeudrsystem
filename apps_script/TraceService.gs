function v27MigrationPlan_(){
 return Object.keys(V27_SCHEMA_).map(n=>{
  const s=db_().getSheetByName(n),expected=V27_SCHEMA_[n],last=s?s.getLastColumn():0;
  // getLastColumn() also sees values in rows below empty header cells. Earlier
  // releases could write override_* data before migrateV23 named those columns.
  const header=s&&last?s.getRange(1,1,1,last).getValues()[0]:[];
  let existing=header.length;
  while(existing&&header[existing-1]==='')existing--;
  if(last>expected.length||(s&&last&&existing===0)||header.slice(0,existing).some((h,i)=>h!==expected[i])){
   const mismatch=header.findIndex((h,i)=>i<existing&&h!==expected[i]);
   fail_('SCHEMA_MISMATCH','Unexpected headers: '+n+' (first mismatch at column '+(mismatch<0?Math.min(last,expected.length)+1:mismatch+1)+')');
  }
  return {table:n,create:!s,existing,append:expected.slice(existing)};
 });
}
function migrateV27(dryRun){
 const email=Session.getEffectiveUser().getEmail().toLowerCase();
 if(!rows_('05_OWNER_MASTER').some(u=>u.email===email&&u.role==='ADMIN'&&u.active==='YES'))fail_('PERMISSION_DENIED','Deploying Admin required');
 return lock_(()=>{
  // Validate every sheet before mutating any header. Only a blank suffix may
  // be named; a gap or a changed/reordered field remains a hard failure.
  const plan=v27MigrationPlan_();
  if(dryRun!==false)return {version:'2.7.0',dryRun:true,plan,records_changed:0};
  for(const p of plan){
   let s=db_().getSheetByName(p.table);
   if(!s){s=db_().insertSheet(p.table);s.appendRow(V27_SCHEMA_[p.table]);s.setFrozenRows(1);}
   else if(p.append.length){
    if(s.getMaxColumns()<V27_SCHEMA_[p.table].length)s.insertColumnsAfter(s.getMaxColumns(),V27_SCHEMA_[p.table].length-s.getMaxColumns());
    // Writes row 1 only; any already populated rows beneath unnamed columns survive.
    s.getRange(1,p.existing+1,1,p.append.length).setValues([p.append]);
   }
  }
  TABLE_CACHE_={};
  if(rows_('09_CONFIG').some(c=>c.key==='SCHEMA_VERSION'))patch_('09_CONFIG','SCHEMA_VERSION',{value:'2.7.0'});
  else add_('09_CONFIG',{key:'SCHEMA_VERSION',value:'2.7.0'});
  audit_('SCHEMA_MIGRATED','','','',JSON.stringify({version:'2.7.0',records_changed:0}),email);
  return {version:'2.7.0',dryRun:false,plan,records_changed:0};
 });
}

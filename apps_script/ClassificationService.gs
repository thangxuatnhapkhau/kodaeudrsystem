function v290PageType_(page){if(!page.text||['OCR_LOW','UNREADABLE'].includes(page.method))return {type:'UNKNOWN',confidence:'LOW'};const text=v290Normalize_(page.text.slice(0,2200)),rules=v290TaxonomyRules_(),title=v290Normalize_(page.text.split(/\n/).find(line=>line.trim())||''),titleMatches=Object.keys(rules).filter(t=>rules[t].test(title)),matches=titleMatches.length===1?titleMatches:Object.keys(rules).filter(t=>rules[t].test(text));if(matches.includes('FSC_SCOPE_ANNEX'))matches.splice(matches.indexOf('FSC_CERTIFICATE'),matches.includes('FSC_CERTIFICATE')?1:0);return {type:matches.length===1?matches[0]:'UNKNOWN',confidence:matches.length===1&&page.confidence>=80?'HIGH':'LOW'};}

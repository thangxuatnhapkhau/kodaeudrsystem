 if(job.type==='ORDER_EXTRACT')normalizeOrderImport_(output,job.case_id,u);if(job.type==='DOSSIER_REVIEW')importDossierResult(job.prompt_run_id,JSON.stringify(output));patch_('28_AI_JOBS',job.id,{status:'DONE',finished_at:now_(),error_code:''});return {id:job.id,status:'DONE'};});}catch(e){
